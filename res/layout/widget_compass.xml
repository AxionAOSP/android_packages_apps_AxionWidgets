<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/card_padding_horizontal"
    android:layout_marginVertical="@dimen/card_padding_vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="8dp">

    <ImageView
        android:id="@+id/compass_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

</FrameLayout>
